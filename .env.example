# Local secrets for simhospital_autoconfig. Gitignored — never commit this file.
# Copy to .env and fill in. Tests that need these skip cleanly when absent.

# Free key from https://api.census.gov/data/key_signup.html
# Without it, api.census.gov returns a "Missing Key" HTML page instead of JSON.
CENSUS_API_KEY=

# Required by tests/test_typesafe_validation.py (live calls to api.typesafe.ai).
TYPESAFE_API_KEY=
